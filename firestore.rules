rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // 🛡️ HELPER FUNCTIONS
    // ==================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // UPDATED: Checks Firestore collections for Admin role
    function isAdmin() {
      return isAuthenticated() && (
        // Check for Custom Claim (optimization)
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) || 
        
        // Check Collections
        exists(/databases/$(database)/documents/Admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ==================================================
    // 👑 ADMIN & PUBLIC CATALOG
    // ==================================================
    match /Admins/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /admins/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Catalog - Public read, Admin write
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subcategories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /offers/{id} { allow read: if true; allow write: if isAdmin(); }
    
    // Promo Codes
    match /promoCodes/{codeId} { allow read: if true; allow write: if isAdmin(); }
    match /promo_codes/{codeId} { allow read: if true; allow write: if isAdmin(); }

    match /adminSettings/{settingType} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Campaigns (for promo code management)
    match /campaigns/{campaignId} { 
      allow read: if isAuthenticated(); 
      allow write: if isAdmin(); 
    }

    // Support Agents - Admin access
    match /agent/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }
    match /agents/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ==================================================
    // 🎫 SUPPORT SYSTEM
    // ==================================================
    match /support_tickets/{ticketId} {
      allow read, write: if isAuthenticated();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    match /supportChats/{chatId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    match /quickReplyTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // ==================================================
    // 👤 USERS (Customers)
    // ==================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /addresses/{addressId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /cart/{itemId} { allow read, write: if isOwner(userId) || isAdmin(); }
    }
    
    match /memberships/{userId} { allow read, write: if isOwner(userId) || isAdmin(); }

    // ==================================================
    // 📦 ORDERS
    // ==================================================
    match /orders/{orderId} {
      // Allow creation by authenticated users (customers)
      allow create: if isAuthenticated(); 
      
      // Allow read/update by Owner, Admin, or authorized Delivery/Vendor personnel
      allow read: if isAuthenticated(); // Simplified for dashboard/riders visibility
      allow update: if isAuthenticated();
      
      match /fulfillmentOrders/{foId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // Collection group for orders (needed for dashboard queries)
    match /{path=**}/orders/{orderId} {
       allow read: if isAuthenticated();
    }

    // ==================================================
    // 🏢 VENDORS
    // ==================================================
    match /vendors/{vendorId} {
      // 1. ADMINS: Full Access
      allow read, write: if isAdmin();
      
      // 2. VENDORS: Manage their own profile
      allow read: if isOwner(vendorId);
      allow create: if isOwner(vendorId);
      allow update: if isOwner(vendorId);

      // Subcollections
      match /payouts/{payoutId} { allow read: if isOwner(vendorId) || isAdmin(); }
      
      match /products/{productId} {
        allow read: if isOwner(vendorId) || isAdmin();
        allow write: if isAdmin(); // Vendors typically don't create global products directly
      }
      
      match /orders/{orderId} {
        allow read: if isOwner(vendorId) || isAdmin();
        allow update: if isOwner(vendorId) || isAdmin();
      }
      
      match /payments/{paymentId} {
        allow read, create: if isOwner(vendorId) || isAdmin();
        allow update: if isAdmin();
      }

      match /documents/{document=**} { allow read, write: if isOwner(vendorId) || isAdmin(); }
      match /settings/{document=**} { allow read, write: if isOwner(vendorId) || isAdmin(); }
      match /bank/{document=**} { allow read, write: if isOwner(vendorId) || isAdmin(); }
      match /notifications/{notificationId} { allow read, write: if isOwner(vendorId) || isAdmin(); }
      match /membership_logs/{logId} { allow read, write: if isOwner(vendorId) || isAdmin(); }
      match /categories/{categoryId} { allow read, write: if isOwner(vendorId) || isAdmin(); }
      match /fulfillmentorders/{orderId} { allow read, write: if isOwner(vendorId) || isAdmin(); }
    }

    // ==================================================
    // 📦 INVENTORY & SKU SOURCE MAP
    // ==================================================
    match /skus/{skuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sku_source_map/{mappingId} {
      // Public read — prices and stock must be visible to all users (even unauthenticated)
      allow read: if true;
      
      // Admin can create and manage all mappings
      allow create: if isAdmin();
      allow delete: if isAdmin();
      
      // Admin can update any mapping
      allow update: if isAdmin();
      
      // Vendor update (limit fields) - only for their own source
      allow update: if isAuthenticated() 
                    && (resource.data.sourceId == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price', 'availableQty', 'status', 'updatedAt']);

      // Transactional updates (reservations) by authenticated users
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys().hasAny(['reservedQty', 'availableQty', 'updatedAt']);
    }

    // New Collections for Fulfillment
    match /sub_orders/{orderId} { allow read, write: if isAuthenticated(); }
    match /stock_reservations/{resId} { allow read, write: if isAuthenticated(); }
    match /delivery_tasks/{taskId} { allow read, write: if isAuthenticated(); }

    match /sku_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.vendorId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Inventory Logs
    match /inventory_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
    }

    // ==================================================
    // 💰 FINANCIALS & TRANSACTIONS
    // ==================================================
    match /purchaseOrders/{orderId} {
      allow read, write: if isAuthenticated(); // Broad access for Vendors/Admins
    }
    
    match /goodsReceiptNotes/{noteId} {
      allow read, write: if isAuthenticated();
    }
    
    match /vendorTransactions/{txnId} {
      allow read, write: if isAuthenticated();
    }

    match /earnings/{earningId} {
      allow read, write: if isAuthenticated();
    }

    // ==================================================
    // 🛵 DELIVERY PARTNERS & TASKS (UPDATED)
    // ==================================================
    match /delivery_partners/{partnerId} {
      // Allow any authenticated user to create a profile (First time set up)
      allow create: if isAuthenticated();
      
      // Allow authenticated users to read profiles (Strictly required for context)
      allow read: if isAuthenticated();
      
      // Allow update ONLY if the document's 'uid' matches the user's Auth UID
      // This is crucial because your Doc ID is Phone, but Auth ID is UID.
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );

      // Allow access to subcollections if you own the parent document
      match /{subcollection=**} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/delivery_partners/$(partnerId)).data.uid == request.auth.uid || 
          isAdmin()
        );
      }
    }

    match /deliveryTasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
    
    match /delivery_hubs/{hubId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /app_config/{document} {
      allow read: if true; // Allows anyone to check the required app version
    }

    // ==================================================
    // 🔧 SYSTEM & SUPPORT
    // ==================================================
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================================================
    // 🔔 FCM TOKENS (Push Notifications)
    // ==================================================
    match /fcm_tokens/{tokenId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /order_reviews/{reviewId} {
      allow read, write: if isAuthenticated();
    }

    match /counters/{counterId} { allow read, write: if isAuthenticated(); }
    match /sources/{sourceId} { allow read: if true; allow write: if isAdmin(); }
    
    // ==================================================
    // 🛒 CART (Top Level)
    // ==================================================
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ==================================================
    // 🚫 DEFAULT FALLBACK
    // ==================================================
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
