rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all images
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to categories folder
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to skus folder
    match /skus/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to banners folder
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
